      "uci_mapping": "0 at enrolment",
      "oulad_mapping": "cutoff day / presentation length",
      "new_school_requirement": "Elapsed days / planned course days"
    },
    {
      "feature": "prior_academic_score",
      "required": false,
      "group": "background",
